{
  "baseUrl": "http://localhost:8080",
  "timeoutMs": 10000,
  "thinkTimeMs": {
    "min": 1000,
    "max": 3000
  },
  "mix": {
    "publicBrowse": 80,
    "adminRead": 20
  },
  "intervalBetweenProfilesMs": 15000,
  "schedulerTickMs": 500,
  "progressLogIntervalMs": 10000,
  "abortCheckIntervalMs": 1000,
  "docker": {
    "enabled": true,
    "containers": ["servija_backend", "servija_mysql", "servija_mongo"]
  },
  "profiles": {
    "50": {
      "warmup": {
        "targetVus": 10,
        "durationMs": 30000
      },
      "ramp": {
        "targetVus": 50,
        "durationMs": 30000
      },
      "sustain": {
        "targetVus": 50,
        "durationMs": 240000
      },
      "cooldown": {
        "targetVus": 0,
        "durationMs": 30000
      }
    },
    "100": {
      "warmup": {
        "targetVus": 10,
        "durationMs": 30000
      },
      "ramp": {
        "targetVus": 100,
        "durationMs": 60000
      },
      "sustain": {
        "targetVus": 100,
        "durationMs": 300000
      },
      "cooldown": {
        "targetVus": 0,
        "durationMs": 60000
      }
    },
    "1000": {
      "warmup": {
        "targetVus": 20,
        "durationMs": 60000
      },
      "ramp": {
        "targetVus": 1000,
        "durationMs": 360000
      },
      "sustain": {
        "targetVus": 1000,
        "durationMs": 240000
      },
      "cooldown": {
        "targetVus": 0,
        "durationMs": 90000
      },
      "abort": {
        "errorRateThreshold": 0.25,
        "windowMs": 60000
      }
    },
    "10000": {
      "warmup": { "targetVus": 200, "durationMs": 120000 },
      "ramp": { "targetVus": 10000, "durationMs": 900000 },
      "sustain": { "targetVus": 10000, "durationMs": 120000 },
      "cooldown": { "targetVus": 0, "durationMs": 180000 },
      "abort": { "errorRateThreshold": 0.4, "windowMs": 60000 }
    },
    "50000": {
      "warmup": { "targetVus": 500, "durationMs": 180000 },
      "ramp": { "targetVus": 50000, "durationMs": 1800000 },
      "sustain": { "targetVus": 50000, "durationMs": 60000 },
      "cooldown": { "targetVus": 0, "durationMs": 300000 },
      "abort": { "errorRateThreshold": 0.5, "windowMs": 60000 }
    }
  }
}
