# ===========================================
# ServiJá - Template de variáveis de ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores conforme necessário.

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- Database (remote/default app profile) ---
SERVIJA_DB_URL=
SERVIJA_DB_USER=
SERVIJA_DB_PASS=

# --- Database (local docker compose) ---
MYSQL_DATABASE=servija_db
MYSQL_ROOT_PASSWORD=servija_root
LOCAL_DB_URL=jdbc:mysql://localhost:4306/servija_db?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true
LOCAL_DB_USER=servija_user
LOCAL_DB_PASS=servija_pass

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- Email (SMTP) ---
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- Category Catalog ---
SERVIJA_CATALOG_SEED_RESOURCE=classpath:catalog/service-category-catalog.json

# --- Admin Bootstrap ---
SERVIJA_ADMIN_BOOTSTRAP_ENABLED=false
SERVIJA_ADMIN_BOOTSTRAP_NAME=
SERVIJA_ADMIN_BOOTSTRAP_EMAIL=
SERVIJA_ADMIN_BOOTSTRAP_PASSWORD=
SERVIJA_ADMIN_BOOTSTRAP_CPF=
SERVIJA_ADMIN_BOOTSTRAP_PHONE=

# --- Frontend ---
VITE_API_URL=
SERVIJA_FRONTEND_PUBLIC_URL=http://localhost:5173

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=sa-east-1
AWS_S3_BUCKET=

# --- Asaas Payment Gateway ---
# Para sandbox/testes: https://api-sandbox.asaas.com
# Para produção: https://api.asaas.com
ASAAS_API_URL=https://api.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WALLET_ID=
ASAAS_NOTIFICATIONS_BACKFILL_ON_STARTUP=false

# --- MongoDB (Chat) ---
MONGODB_URI=mongodb+srv://<user>:<senha>@<cluster>.mongodb.net/servija_chat?appName=servija-chat
# Local: o perfil "local" usa por padrão o container do docker-compose (mongodb://mongo:27017/servija_chat),
# MONGODB_URI_LOCAL=mongodb://localhost:37017/servija_chat


#local:
#SERVIJA_FRONTEND_PUBLIC_URL=http://

#homolog:
#SERVIJA_FRONTEND_PUBLIC_URL=https://

#prod:
#SERVIJA_FRONTEND_PUBLIC_URL=https://